<?xml version="1.0" encoding="UTF-8"?>
<project >
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version> <!-- 3.2.x is past OSS EOL; 3.5.x is the current supported 3.x line -->
        <relativePath/>
    </parent>

    <groupId>com.message.inspector</groupId>
    <artifactId>message-inspector</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>message-inspector</name>
    <description>Tool to view, resend, and debug messages in queues.</description>

    <properties>
        <java.version>21</java.version>
        <lombok.version>1.18.38</lombok.version>
        <!-- netty is no longer overridden here: the 4.1.110 pin dated from Boot 3.2.6 (which
             managed 4.1.109) and had become a downgrade, holding netty below the version the
             parent now manages. Let the parent govern it. -->
        <springdoc.version>2.8.17</springdoc.version> <!-- 2.8.x targets Boot 3.5; 3.x is for Boot 4 -->

        <!-- Targeted CVE overrides, each ahead of what the parent manages today.
             EXPIRY: drop each one as soon as the parent catches up. An override that
             outlives its reason silently becomes a downgrade, which is exactly how the
             old netty 4.1.110 and jackson-bom 2.19.0 pins ended up holding this build
             back. Re-check these at every parent bump.
               tomcat        parent 10.1.55 -> 10.1.57 (CVE-2026-59083, -59084, -53434,
                             -55276 critical; -53404 high; -55955, -55956, -50229 medium)
               commons-lang3 parent 3.17.0  -> 3.20.0  (CVE-2025-48924) -->
        <tomcat.version>10.1.57</tomcat.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <artemis.version>2.55.0</artemis.version>
    </properties>

    <dependencies>
        <!-- Core Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-artemis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- OpenAPI / Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version> <!-- consider upgrading when new safe versions available -->
        </dependency>

        <!-- Lombok, Jackson -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Declared because ApplicationConfig uses ObjectMapper directly; version comes
             from the parent. Do not re-pin it via a jackson-bom import: that override was
             what held jackson at 2.19.0 while the parent had moved to 2.21.x. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- org.apache.artemis, not org.apache.activemq: Artemis became a top-level
             Apache project and migrated groupId. The old coordinates still resolve, but
             only via a relocation stub. See
             https://artemis.apache.org/artemis-tlp-groupid-migration -->
        <dependency>
            <groupId>org.apache.artemis</groupId>
            <artifactId>artemis-junit-5</artifactId>
            <version>2.55.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.18.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-inline</artifactId>
            <version>5.2.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>it.ozimov</groupId>
            <artifactId>embedded-redis</artifactId>
            <version>0.7.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- Targeted CVE override: commons-beanutils arrives transitively via the
                 Artemis client chain and is NOT managed by the Spring Boot parent, so it
                 cannot be pinned with a property. 1.10.1 -> 1.11.0 for CVE-2025-48734.
                 EXPIRY: remove once Artemis ships a client depending on >= 1.11.0. -->
            <dependency>
                <groupId>commons-beanutils</groupId>
                <artifactId>commons-beanutils</artifactId>
                <version>1.11.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Spring Boot packaging -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Surefire -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- api.version pins the Docker API version used by docker-java (via Testcontainers).
                         Its default (1.32) is below the 1.40 minimum enforced by Docker Engine 29+, which
                         rejects it with an empty HTTP 400 from /info and makes every Testcontainers test
                         fail with "Could not find a valid Docker environment". Note DOCKER_API_VERSION is
                         a docker-CLI-only variable; docker-java reads this system property instead. -->
                    <argLine>-Djdk.attach.allowAttachSelf -XX:+EnableDynamicAgentLoading -Dapi.version=1.44</argLine>
                </configuration>
            </plugin>

            <!-- Failsafe runs the *IT integration tests, which surefire's default includes
                 skip. Without this, MessageServiceIT was dead code that compiled but never
                 executed, and no automated test opened a JMS connection at all, so every
                 broker-level defect had to be found by driving the app by hand.
                 Bound to verify, so `mvn test` stays fast and unit-only:
                   ./mvnw test     -> surefire only (unit)
                   ./mvnw verify   -> surefire + failsafe (needs Docker for the broker) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Same Docker API pin as surefire, and for the same reason. -->
                    <argLine>-Djdk.attach.allowAttachSelf -XX:+EnableDynamicAgentLoading -Dapi.version=1.44</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- OWASP Dependency Check. Needs an NVD API key; supplied as nvd.api.key
                 from the active 'nvd' profile in ~/.m2/settings.xml. Without it the NVD
                 feed download is rate-limited to the point of being unusable. -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>12.2.2</version>
                <configuration>
                    <nvdApiKey>${nvd.api.key}</nvdApiKey>
                    <suppressionFiles>
                        <suppressionFile>dependency-check-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                    <!-- 11 is above the maximum CVSS score of 10, so nothing fails the
                         build. Set explicitly rather than left to default so the value is
                         visible and the intent is on the record: reporting only, until the
                         remaining findings have been triaged. Lower it (7 or 8 is typical)
                         once suppressions exist for what has been judged inapplicable;
                         that is what turns this into a real gate for the Phase 7 CI. -->
                    <failBuildOnCVSS>11</failBuildOnCVSS>
                </configuration>
                <executions>
                    <execution>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Versions plugin -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>2.15.0</version>
            </plugin>
        </plugins>
    </build>
</project>