<?xml version="1.0" encoding="UTF-8"?>
<project >
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version> <!-- current 4.1 patch; notification-platform is on 4.1.1 -->
        <relativePath/>
    </parent>

    <groupId>com.message.inspector</groupId>
    <artifactId>message-inspector</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>message-inspector</name>
    <description>Tool to view, resend, and debug messages in queues.</description>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>3.2.0</springdoc.version> <!-- 3.2.x is built on Boot 4.1.2; 2.8.x was Boot 3.5 -->
        <spring-ai.version>2.0.2</spring-ai.version> <!-- 2.0.x is built on Boot 4.1.2; 2.1.x targets Boot 4.2 -->

        <!-- Targeted overrides, each re-checked against Boot 4.1.2 (ADR 0002).
             Dropped on this bump because keeping them would invert into a downgrade
             or a no-op:
               tomcat        was 10.1.57; parent now manages Tomcat 11.0.27 (Servlet 6.1).
                             A 10.1 pin does not even run on Boot 4.
               netty         was 4.1.136.Final; parent now manages 4.2.19.Final.
               commons-lang3 was 3.20.0; parent now manages 3.20.0 (pure redundancy).
               lombok        was 1.18.38; parent now manages 1.18.48.
               mockito       was 5.18.0 / mockito-inline 5.2.0; parent manages 5.23.0
                             and the inline mock maker is part of mockito-core.
               commons-beanutils was 1.11.0 in dependencyManagement; Artemis 2.55.0
                             now declares 1.11.0 itself (CVE-2025-48734).
             Still ahead of the parent:
               artemis       parent 2.53.0 -> 2.57.0. Boot 4.1 imports
                             org.apache.artemis:artemis-bom, so this property still
                             applies to the post-TLP coordinates. Moved 2.55.0 -> 2.57.0
                             for CVE-2026-57967, -49364, -67593 (critical) and -49362,
                             -49363 (high), all "2.50.0 through 2.56.0, fixed in 2.57.0".
                             They are broker-side flaws CPE-matched onto the client jar,
                             but they fail the OWASP gate all the same.
                             EXPIRY: drop when the parent manages >= 2.57.0. -->
        <artemis.version>2.57.0</artemis.version>

        <!-- Build plugins ahead of the parent's pluginManagement. Set through the
             parent's own version properties (ADR 0002), not a <version> on the plugin.
               surefire/failsafe parent 3.5.6 -> 3.6.1. No CVE; taken for currency.
                             EXPIRY: drop both when the parent manages >= 3.6.1.
               versions      parent 2.21.0 -> 2.23.0. Replaces an explicit
                             <version>2.21.0</version> that only restated the parent.
                             EXPIRY: drop when the parent manages >= 2.23.0. -->
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.6.1</maven-failsafe-plugin.version>
        <versions-maven-plugin.version>2.23.0</versions-maven-plugin.version>
    </properties>

    <dependencies>
        <!-- Core Spring Boot. starter-web and starter-oauth2-resource-server are
             deprecated aliases in Boot 4; the names below are the supported ones. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-artemis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- JWT bearer auth. Brings spring-security-oauth2-jose (Nimbus), which supplies
             both the resource-server JwtDecoder (validation) and the NimbusJwtEncoder we
             sign tokens with, so no separate JWT library (jjwt) is needed. Parent-managed
             version. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <!-- OpenAPI / Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- MCP server for AI agents, Streamable HTTP over the existing WebMVC stack and
             security chain (ADR 0009).
             Exclusions:
             - spring-boot-starter-web: the deprecated Boot 4 alias; it adds nothing over
               starter-webmvc above.
             - swagger-annotations-jakarta: Spring AI brings 2.2.38 on a shorter path than
               springdoc's swagger-core 2.2.55, so nearest-wins silently downgraded the
               annotations under springdoc. Excluding it here lets swagger-core's own
               version win. If springdoc is ever removed, drop this exclusion with it.
               EXPIRY: drop when spring-ai-model's swagger-annotations-jakarta is >= the
               swagger-core-jakarta springdoc brings (re-check at each bump of either). -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
            <version>${spring-ai.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.swagger.core.v3</groupId>
                    <artifactId>swagger-annotations-jakarta</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Lombok. Version comes from the parent. Jackson 3 (tools.jackson) arrives
             via starter-webmvc; do not re-declare com.fasterxml.jackson.core:jackson-databind.
             That explicit Jackson 2 dependency is what a previous pin used to freeze. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @WebMvcTest / @AutoConfigureMockMvc live in the webmvc test module in Boot 4;
             starter-test no longer brings them. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @WithMockUser needs Boot's security test slice, not only spring-security-test. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Renamed in Testcontainers 2 (Boot 4.1 manages 2.0.x). The old artifact id
             was junit-jupiter. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot packaging -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Surefire. Version comes from maven-surefire-plugin.version above (3.6.1;
                 the parent manages 3.5.6). The old explicit 3.2.5 pin was behind both. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- api.version pins the Docker API version used by docker-java (via Testcontainers).
                         Its default (1.32) is below the 1.40 minimum enforced by Docker Engine 29+, which
                         rejects it with an empty HTTP 400 from /info and makes every Testcontainers test
                         fail with "Could not find a valid Docker environment". Note DOCKER_API_VERSION is
                         a docker-CLI-only variable; docker-java reads this system property instead.
                         Engine 29.1 accepts 1.44 (its minimum) through 1.52. -->
                    <argLine>-Djdk.attach.allowAttachSelf -XX:+EnableDynamicAgentLoading -Dapi.version=1.44</argLine>
                </configuration>
            </plugin>

            <!-- Failsafe runs the *IT integration tests, which surefire's default includes
                 skip. Without this, MessageServiceIT was dead code that compiled but never
                 executed, and no automated test opened a JMS connection at all, so every
                 broker-level defect had to be found by driving the app by hand.
                 Bound to verify, so `mvn test` stays fast and unit-only:
                   ./mvnw test     -> surefire only (unit)
                   ./mvnw verify   -> surefire + failsafe (needs Docker for the broker) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- Same Docker API pin as surefire, and for the same reason. -->
                    <argLine>-Djdk.attach.allowAttachSelf -XX:+EnableDynamicAgentLoading -Dapi.version=1.44</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- OWASP Dependency Check. Needs an NVD API key; supplied as nvd.api.key
                 from the active 'nvd' profile in ~/.m2/settings.xml. Without it the NVD
                 feed download is rate-limited to the point of being unusable. -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>13.0.0</version>
                <configuration>
                    <nvdApiKey>${nvd.api.key}</nvdApiKey>
                    <suppressionFiles>
                        <suppressionFile>dependency-check-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                    <!-- Gate on HIGH and CRITICAL (CVSS >= 7). This is the gate the
                         security CI job enforces. -->
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                </configuration>
                <executions>
                    <execution>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Versions plugin. Version comes from versions-maven-plugin.version above. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
